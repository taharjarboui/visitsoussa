---
import type { Lang } from '../i18n/ui';
import { useTranslations, sectionUrl, contactUrl } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-azur-900 text-chaux">
  <div class="h-3 bg-soleil-500"></div>
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <img src="/images/logo.png" alt="Visit Soussa" width="120" height="90" class="h-16 w-auto bg-chaux rounded-xl p-2" />
      <h2 class="mt-5 text-xl">{t('footer.about')}</h2>
      <p class="mt-2 max-w-md text-chaux/80 leading-relaxed">{t('footer.about.text')}</p>
    </div>
    <div>
      <h2 class="text-xl">{t('footer.partners')}</h2>
      <ul class="mt-3 space-y-2 text-chaux/80">
        <li>Association de sauvegarde de la ville de Sousse</li>
        <li>Association Recherche et Étude Mémoire de Sousse</li>
        <li>Festival International de Sousse</li>
        <li>Étoile Sportive du Sahel · Tennis Club de Sousse</li>
        <li>Réseau Entreprendre</li>
      </ul>
    </div>
    <div>
      <h2 class="text-xl">{t('footer.contact')}</h2>
      <ul class="mt-3 space-y-2 text-chaux/80">
        <li><a class="hover:text-soleil-500" href={contactUrl(lang)}>{t('contact.title')}</a></li>
        <li><a class="hover:text-soleil-500" href={sectionUrl(lang, 'preparer')}>{t('nav.preparer')}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-chaux/10">
    <p class="container-x py-5 text-sm text-chaux/60">© {year} Visit Soussa. {t('footer.rights')}</p>
  </div>
</footer>
